  "operationId": "listSources",
  "summary": "Two sources read through definitions, and the server itself as the hosted source.",
  "request": {
    "method": "GET",
    "path": "/api/v1/sources",
    "headers": {
      "User-Agent": "AbyssReader/1.0.0 (android)",
      "Accept-Language": "en"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "items": [
        {
          "slug": "lantern",
          "name": "Lantern Library",
          "iconUrl": "https://lantern.example.org/static/icon.png",
          "lang": "en",
          "website": "https://lantern.example.org",
          "hosted": true
        },
        {
          "slug": "paper-moon",
          "name": "Paper Moon Comics",
          "iconUrl": "https://cdn.example.net/icons/paper-moon.png",
          "lang": "en",
          "website": "https://papermoon.example.com",
          "hosted": false
        },
        {
          "slug": "luna-es",
          "name": "Luna Cómics",
          "iconUrl": null,
          "lang": "es",
          "website": "https://luna.example.net",
          "hosted": false
        }
      ]
    }
  }
}
