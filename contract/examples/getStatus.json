  "operationId": "getStatus",
  "summary": "A server with three optional features switched on.",
  "request": {
    "method": "GET",
    "path": "/api/status",
    "headers": {
      "User-Agent": "AbyssReader/1.0.0 (android)",
      "Accept-Language": "en"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "name": "Lantern Library",
      "accessKeyRequired": false,
      "signUpOpen": true,
      "operator": {
        "name": "Lantern Library team",
        "contact": "mailto:operator@lantern.example.org",
        "privacyUrl": "https://lantern.example.org/privacy",
        "termsUrl": "https://lantern.example.org/terms",
        "copyrightUrl": "https://lantern.example.org/copyright"
      },
      "contracts": [
        {
          "version": "1.0",
          "basePath": "/api/v1",
          "features": [
            "comments",
            "collections",
            "hosted-chapters"
          ]
        }
      ]
    }
  }
}
