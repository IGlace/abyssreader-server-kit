  "operationId": "restoreBackup",
  "summary": "Restoring a Mihon backup: two by source website or id, one by name, one unmatched.",
  "request": {
    "method": "POST",
    "path": "/api/v1/me/backup/restore",
    "headers": {
      "User-Agent": "AbyssReader/1.0.0 (android)",
      "Accept-Language": "en",
      "Authorization": "Bearer eyJhbGciOiJIUzUxMiJ9.opaque-session-token.example",
      "Content-Type": "multipart/form-data; boundary=abyss"
    },
    "body": {
      "file": "(binary: mihon_2026-11-17.tachibk, gzip'd protobuf)"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "titles": {
        "matched": 2,
        "matchedByName": 1,
        "unmatched": 1
      },
      "chapterMarks": {
        "restored": 41,
        "skipped": 6
      },
      "unmatched": [
        {
          "title": "A Title This Server Lacks",
          "sourceName": "Some Other Source"
        }
      ]
    }
  }
}
